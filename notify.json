---
layout: null
permalink: /notify.json
sitemap: false
---
{%- assign T = site.data.text -%}
{
  "texts": {
    "site_name": {{ T.site_name | jsonify }},
    "mail_sender_name": {{ T.mail_sender_name | jsonify }},
    "mail_confirm_subject": {{ T.mail_confirm_subject | jsonify }},
    "mail_confirm_body": {{ T.mail_confirm_body | jsonify }},
    "mail_confirm_button": {{ T.mail_confirm_button | jsonify }},
    "mail_confirm_ignore": {{ T.mail_confirm_ignore | jsonify }},
    "mail_post_subject": {{ T.mail_post_subject | jsonify }},
    "mail_post_read": {{ T.mail_post_read | jsonify }},
    "mail_footer": {{ T.mail_footer | jsonify }},
    "mail_unsubscribe": {{ T.mail_unsubscribe | jsonify }}
  },
  "posts": [
  {%- for p in site.posts limit: 20 -%}
    {%- assign c = site.data.categories[p.cat] -%}
    {%- capture summary -%}{%- if p.summary and p.summary != "" -%}{{ p.summary }}{%- else -%}{{ p.content | strip_html | strip_newlines | truncate: 120 }}{%- endif -%}{%- endcapture -%}
    {
      "id": {{ p.id | jsonify }},
      "url": {{ p.url | absolute_url | jsonify }},
      "title": {{ p.title | jsonify }},
      "subtitle": {{ p.subtitle | default: "" | jsonify }},
      "summary": {{ summary | strip | jsonify }},
      "cat": {{ c.name | default: "" | jsonify }},
      "date": {{ p.date | date_to_xmlschema | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ]
}
